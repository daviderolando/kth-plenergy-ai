1], [1.113, -0.245], [-1.031, -0.057], [1.049, -0.976], [-0.911, 0.559], [-0.222, 0.647], [-0.014, 0.702], [-1.035, -0.012], [-0.211, -1.216], [-1.563, 0.686], [-0.351, -1.022], [-0.096, 1.128], [-2.281, -1.497], [-0.923, 1.461], [0.283, 0.767], [-1.14, -1.12], [0.448, 0.058], [0.549, -0.188], [0.278, 0.158], [0.778, 0.807], [-1.62, -2.247], [1.002, 1.188], [-1.021, -1.86], [0.099, 0.931], [1.798, 0.516], [-0.372, -0.893], [0.011, -0.299], [-1.015, 2.049], [1.785, 1.136], [-0.921, 0.855], [0.64, 0.443], [1.25, 0.635], [0.74, 0.637], [0.341, -1.784], [0.084, -0.556], [-1.28, 1.682], [1.729, 1.359], [0.255, 1.351], [0.012, 0.203], [-1.093, 0.397], [0.06, -1.303], [-0.051, -0.08], [1.798, 0.894], [0.011, 0.249], [0.044, -0.203], [-1.082, -0.151], [-0.746, -1.25], [0.511, 0.391], [-1.787, -0.123], [0.996, 1.059], [1.026, 0.039]];</script>\n\n\n:::: {.columns}\n\n::: {.column width=\"30%\"}\n```{=html}\n<div id=\"sel-controls\" style=\"font-size:0.65em; line-height:1.6\">\n  <label>Talent weight: <b id=\"w-out\">0.50</b><br>\n    <input id=\"w\" type=\"range\" min=\"0\" max=\"1\" step=\"0.05\" value=\"0.5\" style=\"width:100%\"></label><br>\n  <label>Selected, top %: <b id=\"top-out\">15</b><br>\n    <input id=\"top\" type=\"range\" min=\"5\" max=\"100\" step=\"5\" value=\"15\" style=\"width:100%\"></label>\n  <p style=\"margin-top:1em\">\n    Correlation of the two traits<br>\n    whole pool: <b id=\"c-all\"></b><br>\n    selected only: <b id=\"c-sel\" style=\"color:#c0392b\"></b>\n  </p>\n</div>\n```\n:::\n\n::: {.column width=\"70%\"}\n```{=html}\n<svg id=\"sel-chart\" viewBox=\"0 0 620 380\" style=\"width:100%; height:auto\"></svg>\n<script>\n(function () {\n  const NS = \"http://www.w3.org/2000/svg\";\n  const W = 620, H = 380, M = 34, LIM = 3;\n  const px = x => M + (x + LIM) / (2 * LIM) * (W - 2 * M);\n  const py = y => H - M - (y + LIM) / (2 * LIM) * (H - 2 * M);\n  const svg = document.getElementById(\"sel-chart\");\n  const el = (tag, attrs, parent) => {\n    const e = document.createElementNS(NS, tag);\n    for (const k in attrs) e.setAttribute(k, attrs[k]);\n    (parent || svg).appendChild(e);\n    return e;\n  };\n  const corr = rows => {\n    const n = rows.length;\n    if (n < 3) return NaN;\n    const mx = rows.reduce((a, r) => a + r[0], 0) / n;\n    const my = rows.reduce((a, r) => a + r[1], 0) / n;\n    let sxy = 0, sxx = 0, syy = 0;\n    for (const r of rows) {\n      sxy += (r[0] - mx) * (r[1] - my);\n      sxx += (r[0] - mx) ** 2;\n      syy += (r[1] - my) ** 2;\n    }\n    return sxy / Math.sqrt(sxx * syy);\n  };\n\n  // static frame, grid and axis labels\n  el(\"rect\", {x: M, y: M, width: W - 2 * M, height: H - 2 * M, fill: \"none\", stroke: \"#999\"});\n  for (let t = -LIM + 1; t < LIM; t++) {\n    el(\"line\", {x1: px(t), y1: M, x2: px(t), y2: H - M, stroke: \"#e3e6ea\"});\n    el(\"line\", {x1: M, y1: py(t), x2: W - M, y2: py(t), stroke: \"#e3e6ea\"});\n  }\n  el(\"text\", {x: W - M, y: H - 8, \"text-anchor\": \"end\", \"font-size\": 14, fill: \"#555\"}, svg).textContent = \"Talent →\";\n  el(\"text\", {x: M + 6, y: M + 16, \"font-size\": 14, fill: \"#555\"}, svg).textContent = \"↑ Looks\";\n  const clip = el(\"clipPath\", {id: \"sel-clip\"});\n  el(\"rect\", {x: M, y: M, width: W - 2 * M, height: H - 2 * M}, clip);\n  const dots = window.POOL.map(() => el(\"circle\", {cx: 0, cy: 0, r: 3}));\n  const line = el(\"line\", {stroke: \"#7b241c\", \"stroke-dasharray\": \"5 4\", \"stroke-width\": 1.5, \"clip-path\": \"url(#sel-clip)\"});\n\n  const wIn = document.getElementById(\"w\"), topIn = document.getElementById(\"top\");\n  function update() {\n    const w = +wIn.value, top = +topIn.value;\n    document.getElementById(\"w-out\").textContent = w.toFixed(2);\n    document.getElementById(\"top-out\").textContent = top;\n    const scores = window.POOL.map(r => w * r[0] + (1 - w) * r[1]);\n    const sorted = scores.slice().sort((a, b) => a - b);\n    const cutoff = sorted[Math.min(sorted.length - 1, Math.floor(sorted.length * (1 - top / 100)))];\n    const chosen = [];\n    window.POOL.forEach((r, i) => {\n      const on = scores[i] >= cutoff;\n      if (on) chosen.push(r);\n      dots[i].setAttribute(\"cx\", px(r[0]));\n      dots[i].setAttribute(\"cy\", py(r[1]));\n      dots[i].setAttribute(\"r\", on ? 4.5 : 2.8);\n      dots[i].setAttribute(\"fill\", on ? \"#c0392b\" : \"#c4cad3\");\n    });\n    // cutoff line: w*x + (1-w)*y = cutoff\n    if (w > 0.999) {\n      line.setAttribute(\"x1\", px(cutoff)); line.setAttribute(\"x2\", px(cutoff));\n      line.setAttribute(\"y1\", py(-LIM)); line.setAttribute(\"y2\", py(LIM));\n    } else {\n      const y = x => (cutoff - w * x) / (1 - w);\n      line.setAttribute(\"x1\", px(-LIM)); line.setAttribute(\"y1\", py(y(-LIM)));\n      line.setAttribute(\"x2\", px(LIM)); line.setAttribute(\"y2\", py(y(LIM)));\n    }\n    const f = v => isNaN(v) ? \"n/a\" : v.toFixed(2);\n    document.getElementById(\"c-all\").textContent = f(corr(window.POOL));\n    document.getElementById(\"c-sel\").textContent = f(corr(chosen));\n  }\n  wIn.addEventListener(\"input\", update);\n  topIn.addEventListener(\"input\", update);\n  update();\n})();\n</script>\n```\n:::\n\n::::\n\nAmong the selected, the traits look **negatively** related, though they are independent: the selection itself creates it (Berkson's paradox).\n\n",
